@page "{id:int}"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "admin")]
@model GalleryApp.Web.Pages.Admin.Pictures.DeleteModel
@{
    ViewData["Title"] = "Delete Picture";
}

<h1>@ViewData["Title"]</h1>

<h3>Are you sure you want to delete this picture?</h3>

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-3">Thumbnail</dt>
                    <dd class="col-sm-9">
                        <img src="@Model.Picture.ThumbnailImagePath" alt="@Model.Picture.Name" style="max-width: 300px;" />
                    </dd>

                    <dt class="col-sm-3">Name</dt>
                    <dd class="col-sm-9">@Model.Picture.Name</dd>

                    <dt class="col-sm-3">Description</dt>
                    <dd class="col-sm-9">@(Model.Picture.Description ?? "-")</dd>

                    <dt class="col-sm-3">Gallery Type</dt>
                    <dd class="col-sm-9">@Model.Picture.GalleryTypeName</dd>

                    <dt class="col-sm-3">Created Date</dt>
                    <dd class="col-sm-9">@Model.Picture.CreatedDate.ToShortDateString()</dd>
                </dl>

                <form method="post">
                    <input type="hidden" asp-for="Picture.Id" />
                    <button type="submit" class="btn btn-danger">Delete</button>
                    <a asp-page="Index" class="btn btn-secondary">Cancel</a>
                </form>
            </div>
        </div>
    </div>
</div>

@page "{id:int}"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "admin")]
@model GalleryApp.Web.Pages.Admin.Pictures.EditModel
@{
    ViewData["Title"] = "Edit Picture";
}

<h1>@ViewData["Title"]</h1>

<div class="row">
    <div class="col-md-8">
        <form method="post" enctype="multipart/form-data">
            <input type="hidden" asp-for="Picture.Id" />
            <input type="hidden" asp-for="Picture.ImagePath" />
            <input type="hidden" asp-for="Picture.ThumbnailImagePath" />

            <div asp-validation-summary="All" class="text-danger"></div>

            <div class="form-group mb-3">
                <label class="form-label">Current Image</label><br />
                <img src="@Model.Picture.ThumbnailImagePath" alt="@Model.Picture.Name" style="max-width: 300px;" />
            </div>

            <div class="form-group mb-3">
                <label asp-for="Picture.Name" class="form-label"></label>
                <input asp-for="Picture.Name" class="form-control" />
                <span asp-validation-for="Picture.Name" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Picture.Description" class="form-label"></label>
                <textarea asp-for="Picture.Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Picture.Description" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Picture.GalleryTypeId" class="form-label">Gallery Type</label>
                <select asp-for="Picture.GalleryTypeId" class="form-control" asp-items="Model.GalleryTypes"></select>
                <span asp-validation-for="Picture.GalleryTypeId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Picture.ImageFile" class="form-label">Change Image (optional)</label>
                <input asp-for="Picture.ImageFile" class="form-control" type="file" accept="image/*" />
                <span asp-validation-for="Picture.ImageFile" class="text-danger"></span>
                <small class="form-text text-muted">Leave empty to keep current image.</small>
            </div>

            <div class="form-group">
                <button type="submit" class="btn btn-primary">Save</button>
                <a asp-page="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

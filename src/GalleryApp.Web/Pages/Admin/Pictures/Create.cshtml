@page
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "admin")]
@model GalleryApp.Web.Pages.Admin.Pictures.CreateModel
@{
    ViewData["Title"] = "Create Picture";
}

<h1>@ViewData["Title"]</h1>

<div class="row">
    <div class="col-md-8">
        <form method="post" enctype="multipart/form-data">
            <div asp-validation-summary="All" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="Picture.Name" class="form-label"></label>
                <input asp-for="Picture.Name" class="form-control" />
                <span asp-validation-for="Picture.Name" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Picture.Description" class="form-label"></label>
                <textarea asp-for="Picture.Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Picture.Description" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Picture.GalleryTypeId" class="form-label">Gallery Type</label>
                <select asp-for="Picture.GalleryTypeId" class="form-control" asp-items="Model.GalleryTypes">
                    <option value="">-- Select Gallery Type --</option>
                </select>
                <span asp-validation-for="Picture.GalleryTypeId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Picture.ImageFile" class="form-label">Image File</label>
                <input asp-for="Picture.ImageFile" class="form-control" type="file" accept="image/*" />
                <span asp-validation-for="Picture.ImageFile" class="text-danger"></span>
            </div>

            <div class="form-group">
                <button type="submit" class="btn btn-primary">Create</button>
                <a asp-page="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

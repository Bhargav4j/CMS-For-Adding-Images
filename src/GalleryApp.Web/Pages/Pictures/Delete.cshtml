@page
@model GalleryApp.Web.Pages.Pictures.DeleteModel
@{
    ViewData["Title"] = "Delete Picture";
}

<h1>Delete Picture</h1>

<h3>Are you sure you want to delete this picture?</h3>

<hr />

@if (Model.Picture != null)
{
    <div class="row">
        <div class="col-md-6">
            <img src="@Model.Picture.ImagePath" alt="@Model.Picture.Name" class="img-fluid mb-3" />
        </div>
        <div class="col-md-6">
            <dl class="row">
                <dt class="col-sm-4">Name</dt>
                <dd class="col-sm-8">@Model.Picture.Name</dd>

                <dt class="col-sm-4">Description</dt>
                <dd class="col-sm-8">@Model.Picture.Description</dd>

                <dt class="col-sm-4">Gallery Type</dt>
                <dd class="col-sm-8">@Model.Picture.GalleryType?.Name</dd>

                <dt class="col-sm-4">Created Date</dt>
                <dd class="col-sm-8">@Model.Picture.CreatedDate.ToString("yyyy-MM-dd HH:mm")</dd>
            </dl>
        </div>
    </div>

    <form method="post">
        <input type="hidden" asp-for="Picture.Id" />
        <div class="form-group mt-3">
            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-page="Index" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
}
else
{
    <div class="alert alert-danger">
        <p>Picture not found.</p>
        <a asp-page="Index" class="btn btn-secondary">Back to List</a>
    </div>
}

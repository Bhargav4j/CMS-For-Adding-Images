@page
@model GalleryApp.Web.Pages.Pictures.IndexModel
@{
    ViewData["Title"] = "Pictures - Manage";
}

<h1>Manage Pictures</h1>

<div class="mb-3">
    <a asp-page="Create" class="btn btn-primary">Add New Picture</a>
</div>

@if (Model.Pictures != null && Model.Pictures.Any())
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Thumbnail</th>
                <th>Name</th>
                <th>Description</th>
                <th>Gallery Type</th>
                <th>Created Date</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var picture in Model.Pictures)
            {
                <tr>
                    <td><img src="@picture.ThumbnailImagePath" alt="@picture.Name" style="width: 50px; height: 50px; object-fit: cover;" /></td>
                    <td>@picture.Name</td>
                    <td>@picture.Description</td>
                    <td>@picture.GalleryType?.Name</td>
                    <td>@picture.CreatedDate.ToString("yyyy-MM-dd")</td>
                    <td>
                        <a asp-page="Details" asp-route-id="@picture.Id" class="btn btn-sm btn-info">Details</a>
                        <a asp-page="Edit" asp-route-id="@picture.Id" class="btn btn-sm btn-warning">Edit</a>
                        <a asp-page="Delete" asp-route-id="@picture.Id" class="btn btn-sm btn-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info">
        <p>No pictures found. <a asp-page="Create">Add your first picture</a></p>
    </div>
}

@page "{galleryId:int?}"
@model GalleryApp.Web.Pages.Gallery.IndexModel
@{
    ViewData["Title"] = "Gallery";
}

<h1>Gallery</h1>

<div class="row mb-3">
    <div class="col-md-12">
        <div class="btn-group" role="group">
            @foreach (var galleryType in Model.GalleryTypes)
            {
                <a asp-page="/Gallery/Index" asp-route-galleryId="@galleryType.Id"
                   class="btn @(Model.SelectedGalleryTypeId == galleryType.Id ? "btn-primary" : "btn-outline-primary")">
                    @galleryType.Name (@galleryType.PictureCount)
                </a>
            }
        </div>
    </div>
</div>

@if (Model.Pictures.Any())
{
    <div class="row">
        @foreach (var picture in Model.Pictures)
        {
            <div class="col-md-4 mb-4">
                <div class="card">
                    <img src="@picture.ThumbnailImagePath" class="card-img-top" alt="@picture.Name"
                         style="height: 250px; object-fit: cover;">
                    <div class="card-body">
                        <h5 class="card-title">@picture.Name</h5>
                        @if (!string.IsNullOrEmpty(picture.Description))
                        {
                            <p class="card-text">@picture.Description</p>
                        }
                        <small class="text-muted">@picture.GalleryTypeName</small>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="alert alert-info">
        No pictures found in this gallery.
    </div>
}

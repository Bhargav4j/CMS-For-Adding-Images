@page
@model GalleryApp.Web.Pages.IndexModel
@{
    ViewData["Title"] = "Home - Gallery Application";
}

<div class="text-center">
    <h1 class="display-4">Welcome to Gallery Application</h1>
    <p class="lead">Browse and manage your image galleries</p>
</div>

<div class="row mt-5">
    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">View Galleries</h5>
                <p class="card-text">Browse through all available image galleries</p>
                <a href="/Gallery" class="btn btn-primary">View Galleries</a>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Manage Pictures</h5>
                <p class="card-text">Add, edit, or delete pictures from galleries (Admin only)</p>
                <a href="/Pictures" class="btn btn-primary">Manage Pictures</a>
            </div>
        </div>
    </div>
</div>

@page "{id:int}"
@model GalleryDetailsModel
@{
    ViewData["Title"] = "Picture Details";
}

@if (Model.Picture != null)
{
    <div class="row">
        <div class="col-12">
            <h2>@Model.Picture.Name</h2>
            <hr />
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <img src="@Model.Picture.ImagePath" class="img-fluid" alt="@Model.Picture.Name">
        </div>
        <div class="col-md-4">
            <h4>Details</h4>
            <dl class="row">
                <dt class="col-sm-4">Gallery Type</dt>
                <dd class="col-sm-8">@Model.Picture.GalleryType?.Name</dd>

                <dt class="col-sm-4">Description</dt>
                <dd class="col-sm-8">@Model.Picture.Description</dd>

                <dt class="col-sm-4">Created Date</dt>
                <dd class="col-sm-8">@Model.Picture.CreatedDate.ToString("yyyy-MM-dd")</dd>
            </dl>

            <div class="mt-3">
                <a asp-page="/Gallery/Index" asp-route-galleryTypeId="@Model.Picture.GalleryTypeId" class="btn btn-secondary">Back to Gallery</a>
            </div>
        </div>
    </div>
}
else
{
    <div class="alert alert-warning">Picture not found.</div>
    <a asp-page="/Gallery/Index" class="btn btn-secondary">Back to Gallery</a>
}

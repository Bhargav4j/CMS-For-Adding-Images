@page "{id:int}"
@model GalleryDetailsModel
@{
    ViewData["Title"] = "Picture Details";
}

<div class="row">
    <div class="col">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-page="/Index">Home</a></li>
                <li class="breadcrumb-item"><a asp-page="/Gallery/Index" asp-route-galleryId="@Model.Picture.GalleryId">Gallery</a></li>
                <li class="breadcrumb-item active">@Model.Picture.Name</li>
            </ol>
        </nav>
    </div>
</div>

<div class="row">
    <div class="col-md-8">
        <img src="@Model.Picture.ImagePath" alt="@Model.Picture.Name" class="img-fluid rounded shadow">
    </div>
    <div class="col-md-4">
        <h2>@Model.Picture.Name</h2>
        <hr />
        <dl class="row">
            <dt class="col-sm-4">Gallery:</dt>
            <dd class="col-sm-8">@Model.Picture.GalleryName</dd>

            <dt class="col-sm-4">Description:</dt>
            <dd class="col-sm-8">@Model.Picture.Description</dd>

            <dt class="col-sm-4">Created:</dt>
            <dd class="col-sm-8">@Model.Picture.CreatedDate.ToShortDateString()</dd>

            <dt class="col-sm-4">By:</dt>
            <dd class="col-sm-8">@Model.Picture.CreatedBy</dd>
        </dl>
        <div class="mt-3">
            <a asp-page="/Gallery/Index" asp-route-galleryId="@Model.Picture.GalleryId" class="btn btn-secondary">Back to Gallery</a>
        </div>
    </div>
</div>

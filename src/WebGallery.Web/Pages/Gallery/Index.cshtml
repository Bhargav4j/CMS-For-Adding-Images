@page "{galleryTypeId:int?}"
@model GalleryIndexModel
@{
    ViewData["Title"] = "Gallery";
}

<div class="row">
    <div class="col-12">
        <h2>Gallery</h2>
        <hr />
    </div>
</div>

<div class="row mb-3">
    <div class="col-12">
        <div class="btn-group" role="group">
            <a asp-page="/Gallery/Index" class="btn btn-outline-primary @(Model.SelectedGalleryTypeId == null ? "active" : "")">All</a>
            @foreach (var galleryType in Model.GalleryTypes)
            {
                <a asp-page="/Gallery/Index" asp-route-galleryTypeId="@galleryType.Id" class="btn btn-outline-primary @(Model.SelectedGalleryTypeId == galleryType.Id ? "active" : "")">@galleryType.Name</a>
            }
        </div>
    </div>
</div>

<div class="row">
    @if (Model.Pictures.Any())
    {
        @foreach (var picture in Model.Pictures)
        {
            <div class="col-md-4 mb-4">
                <div class="card">
                    <img src="@picture.ThumbnailImagePath" class="card-img-top" alt="@picture.Name" style="height: 250px; object-fit: cover;">
                    <div class="card-body">
                        <h5 class="card-title">@picture.Name</h5>
                        <p class="card-text">@(picture.Description.Length > 100 ? picture.Description.Substring(0, 100) + "..." : picture.Description)</p>
                        <a asp-page="/Gallery/Details" asp-route-id="@picture.Id" class="btn btn-primary">View Details</a>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12">
            <div class="alert alert-info">No pictures found in this gallery.</div>
        </div>
    }
</div>

@page "{id:int}"
@model PictureDetailsModel
@{
    ViewData["Title"] = "Picture Details";
}

<h2>@ViewData["Title"]</h2>

@if (Model.Picture != null)
{
    <div class="row">
        <div class="col-md-8">
            @if (!string.IsNullOrEmpty(Model.Picture.ImagePath))
            {
                <img src="@Model.Picture.ImagePath" class="img-fluid" alt="@Model.Picture.Name" />
            }
        </div>
        <div class="col-md-4">
            <h3>@Model.Picture.Name</h3>
            <p>@Model.Picture.Description</p>
            <dl class="row">
                <dt class="col-sm-4">Gallery Type:</dt>
                <dd class="col-sm-8">@Model.Picture.GalleryType?.Name</dd>
                <dt class="col-sm-4">Created:</dt>
                <dd class="col-sm-8">@Model.Picture.CreatedDate.ToString("yyyy-MM-dd HH:mm")</dd>
                <dt class="col-sm-4">Created By:</dt>
                <dd class="col-sm-8">@Model.Picture.CreatedBy</dd>
            </dl>
            <div class="mt-3">
                <a asp-page="./Index" class="btn btn-secondary">Back to List</a>
                @if (User.IsInRole("admin"))
                {
                    <a asp-page="./Edit" asp-route-id="@Model.Picture.Id" class="btn btn-primary">Edit</a>
                    <a asp-page="./Delete" asp-route-id="@Model.Picture.Id" class="btn btn-danger">Delete</a>
                }
            </div>
        </div>
    </div>
}
else
{
    <div class="alert alert-warning">Picture not found.</div>
    <a asp-page="./Index" class="btn btn-secondary">Back to List</a>
}

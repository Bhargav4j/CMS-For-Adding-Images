@page
@model WebGallery.Web.Pages.Pictures.DetailsModel
@{
    ViewData["Title"] = "Picture Details";
}

<h1>Picture Details</h1>

@if (Model.Picture != null)
{
    <div>
        <h4>@Model.Picture.Name</h4>
        <hr />
        <div class="row">
            <div class="col-md-6">
                @if (!string.IsNullOrEmpty(Model.Picture.ImagePath))
                {
                    <img src="@Model.Picture.ImagePath" class="img-fluid" alt="@Model.Picture.Name">
                }
            </div>
            <div class="col-md-6">
                <dl class="row">
                    <dt class="col-sm-4">Name</dt>
                    <dd class="col-sm-8">@Model.Picture.Name</dd>

                    <dt class="col-sm-4">Description</dt>
                    <dd class="col-sm-8">@Model.Picture.Description</dd>

                    <dt class="col-sm-4">Gallery Type</dt>
                    <dd class="col-sm-8">@Model.Picture.GalleryTypeName</dd>

                    <dt class="col-sm-4">Created Date</dt>
                    <dd class="col-sm-8">@Model.Picture.CreatedDate.ToString("yyyy-MM-dd HH:mm")</dd>
                </dl>
            </div>
        </div>
    </div>
    <div class="mt-3">
        <a asp-page="Edit" asp-route-id="@Model.Picture.Id" class="btn btn-warning">Edit</a>
        <a asp-page="Delete" asp-route-id="@Model.Picture.Id" class="btn btn-danger">Delete</a>
        <a asp-page="Index" class="btn btn-secondary">Back to List</a>
    </div>
}
else
{
    <p>Picture not found.</p>
    <a asp-page="Index" class="btn btn-secondary">Back to List</a>
}

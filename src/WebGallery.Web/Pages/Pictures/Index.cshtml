@page
@model WebGallery.Web.Pages.Pictures.IndexModel
@{
    ViewData["Title"] = "Pictures";
}

<h1>Pictures</h1>

<p>
    <a asp-page="Create" class="btn btn-primary">Create New</a>
</p>

<form method="get" class="mb-3">
    <div class="input-group">
        <input type="text" name="searchString" value="@Model.SearchString" class="form-control" placeholder="Search pictures..." />
        <button type="submit" class="btn btn-outline-secondary">Search</button>
        <a asp-page="./Index" class="btn btn-outline-secondary">Clear</a>
    </div>
</form>

<div class="row">
    @if (Model.Pictures != null && Model.Pictures.Any())
    {
        @foreach (var item in Model.Pictures)
        {
            <div class="col-md-4 mb-4">
                <div class="card">
                    @if (!string.IsNullOrEmpty(item.ThumbnailImagePath))
                    {
                        <img src="@item.ThumbnailImagePath" class="card-img-top" alt="@item.Name" />
                    }
                    <div class="card-body">
                        <h5 class="card-title">@item.Name</h5>
                        <p class="card-text">@item.Description</p>
                        <p class="card-text"><small class="text-muted">Gallery: @item.GalleryTypeName</small></p>
                        <div class="btn-group" role="group">
                            <a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Details</a>
                            <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edit</a>
                            <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12">
            <p>No pictures found.</p>
        </div>
    }
</div>

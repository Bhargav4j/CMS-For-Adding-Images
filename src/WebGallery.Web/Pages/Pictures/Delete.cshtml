@page "{id:int}"
@model PictureDeleteModel
@{
    ViewData["Title"] = "Delete Picture";
}

<h2>@ViewData["Title"]</h2>

<h3>Are you sure you want to delete this picture?</h3>

@if (Model.Picture != null)
{
    <div class="row">
        <div class="col-md-6">
            <dl class="row">
                <dt class="col-sm-4">Name:</dt>
                <dd class="col-sm-8">@Model.Picture.Name</dd>
                <dt class="col-sm-4">Description:</dt>
                <dd class="col-sm-8">@Model.Picture.Description</dd>
                <dt class="col-sm-4">Gallery Type:</dt>
                <dd class="col-sm-8">@Model.Picture.GalleryType?.Name</dd>
            </dl>
            @if (!string.IsNullOrEmpty(Model.Picture.ThumbnailImagePath))
            {
                <img src="@Model.Picture.ThumbnailImagePath" alt="@Model.Picture.Name" class="img-thumbnail" />
            }
            <form method="post" class="mt-3">
                <button type="submit" class="btn btn-danger">Delete</button>
                <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
            </form>
        </div>
    </div>
}
else
{
    <div class="alert alert-warning">Picture not found.</div>
    <a asp-page="./Index" class="btn btn-secondary">Back to List</a>
}

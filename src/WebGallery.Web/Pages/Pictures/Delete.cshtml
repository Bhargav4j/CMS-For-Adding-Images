@page
@model WebGallery.Web.Pages.Pictures.DeleteModel
@{
    ViewData["Title"] = "Delete Picture";
}

<h1>Delete Picture</h1>

<h3>Are you sure you want to delete this picture?</h3>

@if (Model.Picture != null)
{
    <div>
        <h4>@Model.Picture.Name</h4>
        <hr />
        <dl class="row">
            <dt class="col-sm-3">Name</dt>
            <dd class="col-sm-9">@Model.Picture.Name</dd>

            <dt class="col-sm-3">Description</dt>
            <dd class="col-sm-9">@Model.Picture.Description</dd>

            <dt class="col-sm-3">Gallery Type</dt>
            <dd class="col-sm-9">@Model.Picture.GalleryTypeName</dd>

            <dt class="col-sm-3">Created Date</dt>
            <dd class="col-sm-9">@Model.Picture.CreatedDate.ToString("yyyy-MM-dd HH:mm")</dd>
        </dl>

        @if (!string.IsNullOrEmpty(Model.Picture.ThumbnailImagePath))
        {
            <div class="mb-3">
                <img src="@Model.Picture.ThumbnailImagePath" style="max-width: 300px;" alt="@Model.Picture.Name" />
            </div>
        }

        <form method="post">
            <input type="hidden" asp-for="Picture.Id" />
            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-page="Index" class="btn btn-secondary">Back to List</a>
        </form>
    </div>
}
else
{
    <p>Picture not found.</p>
    <a asp-page="Index" class="btn btn-secondary">Back to List</a>
}

@page "{id:int}"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]
@model AdminPicturesDeleteModel
@{
    ViewData["Title"] = "Delete Picture";
}

@if (Model.Picture != null)
{
    <div class="row">
        <div class="col-md-8">
            <h2>Delete Picture</h2>
            <hr />
            <div class="alert alert-warning">
                <strong>Warning!</strong> Are you sure you want to delete this picture?
            </div>

            <dl class="row">
                <dt class="col-sm-3">Name</dt>
                <dd class="col-sm-9">@Model.Picture.Name</dd>

                <dt class="col-sm-3">Description</dt>
                <dd class="col-sm-9">@Model.Picture.Description</dd>

                <dt class="col-sm-3">Gallery Type</dt>
                <dd class="col-sm-9">@Model.Picture.GalleryType?.Name</dd>

                <dt class="col-sm-3">Image</dt>
                <dd class="col-sm-9">
                    <img src="@Model.Picture.ThumbnailImagePath" alt="@Model.Picture.Name" style="max-width: 200px;">
                </dd>
            </dl>

            <form method="post">
                <button type="submit" class="btn btn-danger">Delete</button>
                <a asp-page="/Admin/Pictures/Index" class="btn btn-secondary">Cancel</a>
            </form>
        </div>
    </div>
}
else
{
    <div class="alert alert-warning">Picture not found.</div>
    <a asp-page="/Admin/Pictures/Index" class="btn btn-secondary">Back to List</a>
}

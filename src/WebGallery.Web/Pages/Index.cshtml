@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

<div class="text-center">
    <h1 class="display-4">Welcome to Web Gallery</h1>
    <p class="lead">Explore our beautiful collection of images and art</p>
    <div class="mt-4">
        <a asp-page="/Gallery/Index" class="btn btn-primary btn-lg">View Gallery</a>
    </div>
</div>

@if (Model.FeaturedPictures.Any())
{
    <div class="row mt-5">
        <div class="col-12">
            <h2>Featured Images</h2>
        </div>
        @foreach (var picture in Model.FeaturedPictures)
        {
            <div class="col-md-4 mb-4">
                <div class="card">
                    <img src="@picture.ThumbnailImagePath" class="card-img-top" alt="@picture.Name">
                    <div class="card-body">
                        <h5 class="card-title">@picture.Name</h5>
                        <p class="card-text">@picture.Description</p>
                        <a asp-page="/Gallery/Details" asp-route-id="@picture.Id" class="btn btn-primary">View Details</a>
                    </div>
                </div>
            </div>
        }
    </div>
}

@page
@model Gallery.Web.Pages.Pictures.DetailsModel
@{
    ViewData["Title"] = "Picture Details";
}

<h1>Picture Details</h1>

<div>
    <hr />
    @if (Model.Picture != null)
    {
        <div class="row">
            <div class="col-md-8">
                @if (!string.IsNullOrEmpty(Model.Picture.ImagePath))
                {
                    <img src="@Model.Picture.ImagePath" alt="@Model.Picture.Name" class="img-fluid" />
                }
            </div>
            <div class="col-md-4">
                <dl class="row">
                    <dt class="col-sm-4">Name</dt>
                    <dd class="col-sm-8">@Model.Picture.Name</dd>

                    <dt class="col-sm-4">Description</dt>
                    <dd class="col-sm-8">@Model.Picture.Description</dd>

                    <dt class="col-sm-4">Gallery Type</dt>
                    <dd class="col-sm-8">@Model.Picture.GalleryType?.Name</dd>

                    <dt class="col-sm-4">Created Date</dt>
                    <dd class="col-sm-8">@Model.Picture.CreatedDate.ToString("g")</dd>

                    <dt class="col-sm-4">Created By</dt>
                    <dd class="col-sm-8">@Model.Picture.CreatedBy</dd>

                    @if (Model.Picture.ModifiedDate.HasValue)
                    {
                        <dt class="col-sm-4">Modified Date</dt>
                        <dd class="col-sm-8">@Model.Picture.ModifiedDate.Value.ToString("g")</dd>

                        <dt class="col-sm-4">Modified By</dt>
                        <dd class="col-sm-8">@Model.Picture.ModifiedBy</dd>
                    }
                </dl>

                <div class="mt-3">
                    @if (User.IsInAuthenticatedRole("admin"))
                    {
                        <a asp-page="Edit" asp-route-id="@Model.Picture.Id" class="btn btn-warning">Edit</a>
                        <a asp-page="Delete" asp-route-id="@Model.Picture.Id" class="btn btn-danger">Delete</a>
                    }
                    <a asp-page="Index" class="btn btn-secondary">Back to List</a>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-warning">Picture not found.</div>
        <a asp-page="Index" class="btn btn-secondary">Back to List</a>
    }
</div>

@page
@model Gallery.Web.Pages.IndexModel
@{
    ViewData["Title"] = "Gallery Home";
}

<div class="text-center">
    <h1 class="display-4">Welcome to Gallery</h1>
    <p class="lead">Browse our collection of pictures organized by gallery types.</p>
</div>

<div class="row mt-4">
    @if (Model.GalleryTypes != null && Model.GalleryTypes.Any())
    {
        @foreach (var galleryType in Model.GalleryTypes)
        {
            <div class="col-md-4 mb-4">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">@galleryType.Name</h5>
                        <p class="card-text">@galleryType.Description</p>
                        <a asp-page="/Pictures/Index" asp-route-galleryTypeId="@galleryType.Id" class="btn btn-primary">View Gallery</a>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12">
            <p class="text-muted">No gallery types available.</p>
        </div>
    }
</div>
